{
  "swagger": "2.0",
  "info": {
    "title": "vrno.cc URL Shortener",
    "description": "Manage the authenticated user's shortened links.",
    "version": "1.0.0"
  },
  "host": "vrno.cc",
  "basePath": "/api/v1",
  "schemes": [
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "securityDefinitions": {
    "bearerToken": {
      "type": "apiKey",
      "in": "header",
      "name": "Authorization"
    }
  },
  "security": [
    {
      "bearerToken": []
    }
  ],
  "paths": {
    "/links": {
      "get": {
        "tags": [
          "Links"
        ],
        "summary": "List links",
        "description": "Returns the authenticated user's links. Results contain 20 links per page.",
        "operationId": "ListLinks",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "default": 1,
            "description": "1-based page number."
          }
        ],
        "responses": {
          "200": {
            "description": "Links retrieved.",
            "schema": {
              "$ref": "#/definitions/LinkListResponse"
            }
          },
          "401": {
            "$ref": "#/responses/Error401"
          },
          "403": {
            "$ref": "#/responses/Error403"
          }
        }
      },
      "post": {
        "tags": [
          "Links"
        ],
        "summary": "Create link",
        "description": "Creates a short link for the authenticated user. Requires write scope.",
        "operationId": "CreateLink",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/LinkCreateRequest"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Link created.",
            "schema": {
              "$ref": "#/definitions/LinkResponse"
            }
          },
          "401": {
            "$ref": "#/responses/Error401"
          },
          "403": {
            "$ref": "#/responses/Error403"
          },
          "409": {
            "description": "The requested custom code is already in use.",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "422": {
            "description": "The request failed validation.",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      }
    },
    "/links/{linkIdentifier}": {
      "get": {
        "tags": [
          "Links"
        ],
        "summary": "Get link by code",
        "description": "Returns a link by short code if it belongs to the authenticated user.",
        "operationId": "GetLink",
        "parameters": [
          {
            "name": "linkIdentifier",
            "in": "path",
            "required": true,
            "type": "string",
            "x-ms-summary": "Short code",
            "description": "The short code, not the numeric link ID."
          }
        ],
        "responses": {
          "200": {
            "description": "Link retrieved.",
            "schema": {
              "$ref": "#/definitions/LinkResponse"
            }
          },
          "401": {
            "$ref": "#/responses/Error401"
          },
          "403": {
            "$ref": "#/responses/Error403"
          },
          "404": {
            "description": "Link not found.",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Links"
        ],
        "summary": "Delete link by ID",
        "description": "Deletes a link by numeric ID if it belongs to the authenticated user. Requires write scope.",
        "operationId": "DeleteLink",
        "parameters": [
          {
            "name": "linkIdentifier",
            "in": "path",
            "required": true,
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "x-ms-summary": "Numeric link ID",
            "description": "The numeric id returned by the API, not the short code."
          }
        ],
        "responses": {
          "200": {
            "description": "Link deleted.",
            "schema": {
              "$ref": "#/definitions/Message"
            }
          },
          "401": {
            "$ref": "#/responses/Error401"
          },
          "403": {
            "$ref": "#/responses/Error403"
          },
          "404": {
            "description": "Link not found.",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "Link": {
      "type": "object",
      "required": [
        "id",
        "short_code",
        "original_url",
        "redirect_type",
        "is_active",
        "click_count",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "format": "int32",
          "description": "Numeric ID used by DeleteLink."
        },
        "owner_id": {
          "type": "integer",
          "format": "int32"
        },
        "short_code": {
          "type": "string"
        },
        "original_url": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "redirect_type": {
          "type": "integer",
          "enum": [
            301,
            302
          ]
        },
        "expires_at": {
          "type": "string",
          "description": "Expiration time in YYYY-MM-DD HH:MM:SS format."
        },
        "max_clicks": {
          "type": "integer",
          "format": "int32"
        },
        "click_count": {
          "type": "integer",
          "format": "int32",
          "minimum": 0
        },
        "is_active": {
          "type": "integer",
          "enum": [
            0,
            1
          ]
        },
        "created_at": {
          "type": "string",
          "description": "Datetime in YYYY-MM-DD HH:MM:SS format."
        },
        "updated_at": {
          "type": "string",
          "description": "Datetime in YYYY-MM-DD HH:MM:SS format."
        }
      }
    },
    "LinkCreateRequest": {
      "type": "object",
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "description": "Absolute URL to shorten."
        },
        "code": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{3,64}$",
          "description": "Optional 3-64 character custom short code. Codes such as admin, install, api, cron, login, logout, register, assets, and health are reserved."
        },
        "title": {
          "type": "string",
          "maxLength": 255
        },
        "redirect_type": {
          "type": "integer",
          "enum": [
            301,
            302
          ],
          "default": 302
        },
        "expires_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}$",
          "description": "Optional expiration time in YYYY-MM-DD HH:MM:SS format."
        }
      }
    },
    "LinkResponse": {
      "type": "object",
      "required": [
        "data"
      ],
      "properties": {
        "data": {
          "$ref": "#/definitions/Link"
        }
      }
    },
    "LinkListResponse": {
      "type": "object",
      "required": [
        "data",
        "meta"
      ],
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Link"
          }
        },
        "meta": {
          "type": "object",
          "required": [
            "page",
            "total"
          ],
          "properties": {
            "page": {
              "type": "integer",
              "format": "int32",
              "minimum": 1
            },
            "total": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          }
        }
      }
    },
    "Error": {
      "type": "object",
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "type": "string"
        }
      }
    },
    "Message": {
      "type": "object",
      "required": [
        "message"
      ],
      "properties": {
        "message": {
          "type": "string"
        }
      }
    }
  },
  "responses": {
    "Error401": {
      "description": "Missing, invalid, or revoked bearer token.",
      "schema": {
        "$ref": "#/definitions/Error"
      }
    },
    "Error403": {
      "description": "API disabled, insufficient scope, or resource not authorized.",
      "schema": {
        "$ref": "#/definitions/Error"
      }
    }
  }
}
